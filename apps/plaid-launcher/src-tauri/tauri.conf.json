{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plaid",
  "version": "0.2.2",
  "identifier": "dev.plaid.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Plaid",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 640,
        "theme": "Dark",
        "backgroundColor": "#000000",
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdCRkIxREFBQkJGOTlFMjAKUldRZ252bTdxaDM3ZTBlV0doSzduR1M4dXYvcWx0KzYrSVZGaHdzMEZwZDRxZUZrMHdPcXM2anEK",
      "endpoints": [
        "https://github.com/sting-raider/Plaid/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
